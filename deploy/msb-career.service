[Unit]
Description=MSB Career Flask application
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/msb-career
EnvironmentFile=-/var/www/msb-career/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m gunicorn --workers 2 --bind 0.0.0.0:5040 --timeout 60 --access-logfile - --error-logfile - wsgi:app
ExecReload=/bin/kill -s HUP $MAINPID
KillSignal=SIGQUIT
TimeoutStopSec=30
Restart=always
RestartSec=5
UMask=0027
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
