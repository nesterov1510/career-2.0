# Скопируйте в .env и заполните своими значениями
# Сгенерировать SECRET_KEY: openssl rand -hex 32
SECRET_KEY=please-change-me-to-a-long-random-string

# Вход в админ-панель при первом запуске
ADMIN_LOGIN=admin
ADMIN_PASSWORD=ChangeMe-Strong-Password!

# Секретный путь админ-панели (без хвостового слэша)
PANEL_PATH=/x-panel-7f3a

# Порт встроенного сервера (python3 wsgi.py / python3 app.py)
PORT=5040

# Для локального HTTP оставьте false. На production с HTTPS установите true.
SESSION_COOKIE_SECURE=false

# true только при работе за вашим Nginx/другим доверенным reverse proxy.
# При прямом доступе к Gunicorn на порту 5040 оставьте false.
TRUST_PROXY=false

# Пути хранения (можно оставить как есть)
# DB_PATH=/var/www/msb-career/data/career.db
# UPLOAD_DIR=/var/www/msb-career/uploads
